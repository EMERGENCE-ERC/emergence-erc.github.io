    <link rel="icon" type="image/png" sizes="16x16" href="assets/images/favicon.png">
        
        <!-- Open Graph / Social Media Preview -->
    <meta property="og:title" content="EMERGENCE - ERC Project | Old English in Continental Europe">
    <meta property="og:description" content="An international conference in Leiden (26-27 January, 2027), co-organized with OE-CONNECT">
