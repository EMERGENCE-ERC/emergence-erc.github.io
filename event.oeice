    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="EMERGENCE - ERC Project | Old English in Continental Europe">
    <meta name="twitter:description" content="An international conference in Leiden (26-27 January, 2027), co-organized with OE-CONNECT">
